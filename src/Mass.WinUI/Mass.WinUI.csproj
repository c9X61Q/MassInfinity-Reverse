<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Mass.WinUI</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Mass.WinUI.Localization.Strings.resources" />
    <EmbeddedResource Include="Mass.WinUI.Localization.Strings.resources" LogicalName="Mass.WinUI.Localization.Strings.resources" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="WinRT.Runtime" />
    <Reference Include="Microsoft.WinUI" />
    <Reference Include="Serilog" />
    <Reference Include="Microsoft.InteractiveExperiences.Projection" />
    <Reference Include="Mass.Application.Desktop">
      <HintPath>../../bf-deobf/Mass.Application.Desktop.dll</HintPath>
    </Reference>
    <Reference Include="Mass.Application.Mobile">
      <HintPath>../../bf-deobf/Mass.Application.Mobile.dll</HintPath>
    </Reference>
    <Reference Include="CommunityToolkit.Mvvm" />
    <Reference Include="Mass.Common">
      <HintPath>../../bf-deobf/Mass.Common.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Windows.SDK.NET" />
    <Reference Include="Mass.Domain">
      <HintPath>../../bf-deobf/Mass.Domain.dll</HintPath>
    </Reference>
    <Reference Include="Mass.Domain.Desktop">
      <HintPath>../../bf-deobf/Mass.Domain.Desktop.dll</HintPath>
    </Reference>
    <Reference Include="Mass.Application">
      <HintPath>../../bf-deobf/Mass.Application.dll</HintPath>
    </Reference>
    <Reference Include="Mass.Domain.Mobile">
      <HintPath>../../bf-deobf/Mass.Domain.Mobile.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core.Projection" />
    <Reference Include="Mass.Game.Proxy">
